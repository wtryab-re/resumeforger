rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: users can only read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's job applications subcollection: users can only manage their own applications
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
